{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API de gestão de clínica odontológica: clínicas, dentistas e pagamentos via Pix (simulado).\nTodos os endpoints de negócio ficam sob o prefixo /api; o único fora dele é o health check em /health.\nErros seguem o formato RFC 9457 (application/problem+json) em todo o corpo, com um campo \"code\" estável para tratamento programático além do \"status\" HTTP.",
        "title": "Clinic API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/clinics": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clinics"
                ],
                "summary": "List/search clinics (paginated)",
                "parameters": [
                    {
                        "maximum": 100,
                        "type": "integer",
                        "default": 20,
                        "description": "Page size",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Offset for pagination",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Free-text search (trade name, legal name, specialties)",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by city (substring, case-insensitive)",
                        "name": "city",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/clinic.listResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a clinic with status \"pending\". It becomes \"active\" automatically once it has at least one dentist marked as administrator and one marked as legal representative.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clinics"
                ],
                "summary": "Create a clinic",
                "parameters": [
                    {
                        "description": "Clinic to create",
                        "name": "clinic",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/clinic.CreateInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/clinic.clinicResponse"
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "document already belongs to another clinic",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/clinics/{clinic_id}/dentists": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dentists"
                ],
                "summary": "List dentists of a clinic (paginated)",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "maximum": 100,
                        "type": "integer",
                        "default": 20,
                        "description": "Page size",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Offset for pagination",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Filter by administrator flag",
                        "name": "is_administrator",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Filter by legal representative flag",
                        "name": "is_legal_representative",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dentist.listResponse"
                        }
                    },
                    "400": {
                        "description": "clinic_id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a dentist attached to the given clinic. Set is_administrator/is_legal_representative afterwards via the roles endpoint if needed.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dentists"
                ],
                "summary": "Create a dentist in a clinic",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Dentist to create",
                        "name": "dentist",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dentist.CreateInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dentist.dentistResponse"
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "email already belongs to another dentist in this clinic",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/clinics/{clinic_id}/dentists/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dentists"
                ],
                "summary": "Get a dentist by id",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Dentist ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dentist.dentistResponse"
                        }
                    },
                    "400": {
                        "description": "id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic or dentist not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "put": {
                "description": "Only non-null fields in the body are applied. Does not change is_administrator/is_legal_representative — use PATCH .../roles for that.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dentists"
                ],
                "summary": "Update a dentist (partial)",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Dentist ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to update",
                        "name": "dentist",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dentist.UpdateInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dentist.dentistResponse"
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic or dentist not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "email already belongs to another dentist in this clinic",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "delete": {
                "description": "Rejected with 409 if the dentist is the clinic's last administrator or last legal representative.",
                "tags": [
                    "dentists"
                ],
                "summary": "Soft-delete a dentist",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Dentist ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "dentist deleted"
                    },
                    "400": {
                        "description": "id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic or dentist not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "would leave the clinic without an administrator or legal representative",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/clinics/{clinic_id}/dentists/{id}/roles": {
            "patch": {
                "description": "An active clinic must always keep at least one administrator and one legal representative; demoting the last one of either role returns 409.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "dentists"
                ],
                "summary": "Update a dentist's administrator/legal representative flags",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Dentist ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Flags to update (at least one required)",
                        "name": "roles",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dentist.RolesInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dentist.dentistResponse"
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic or dentist not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "would leave the clinic without an administrator or legal representative",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/clinics/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clinics"
                ],
                "summary": "Get a clinic by id",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/clinic.clinicResponse"
                        }
                    },
                    "400": {
                        "description": "id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "put": {
                "description": "Only non-null fields in the body are applied. \"document\" cannot be changed after creation and returns 400 DOCUMENT_IMMUTABLE if attempted.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "clinics"
                ],
                "summary": "Update a clinic (partial)",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to update",
                        "name": "clinic",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/clinic.UpdateInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/clinic.clinicResponse"
                        }
                    },
                    "400": {
                        "description": "validation error or attempt to change document",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "delete": {
                "description": "Marks the clinic as deleted (DeletedAt is set); it stops appearing in list/get and its document becomes reusable for a new clinic. Existing dentists and payments are not affected.",
                "tags": [
                    "clinics"
                ],
                "summary": "Soft-delete a clinic",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "clinic deleted"
                    },
                    "400": {
                        "description": "id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/payments": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "List payments for a clinic (paginated)",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Clinic ID",
                        "name": "clinic_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "pending",
                            "approved"
                        ],
                        "type": "string",
                        "description": "Filter by status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "type": "integer",
                        "default": 20,
                        "description": "Page size",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Offset for pagination",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/payment.listResponse"
                        }
                    },
                    "400": {
                        "description": "clinic_id missing or not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a \"pending\" payment with a simulated Pix copy-and-paste code. A background job approves it automatically after a random 2-5s delay. Replaying the same Idempotency-Key with the same body returns the original payment (200); replaying it with a different body returns 409.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Create a Pix payment",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Client-generated unique key; safe to retry a request with the same key",
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Payment to create",
                        "name": "payment",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/payment.CreateInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "replay of an existing payment (same Idempotency-Key and body)",
                        "schema": {
                            "$ref": "#/definitions/payment.paymentResponse"
                        }
                    },
                    "201": {
                        "description": "payment created",
                        "schema": {
                            "$ref": "#/definitions/payment.paymentResponse"
                        }
                    },
                    "400": {
                        "description": "missing Idempotency-Key header or validation error",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "clinic or dentist not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "409": {
                        "description": "clinic not active, or Idempotency-Key reused with a different body",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        },
        "/payments/{id}": {
            "get": {
                "description": "Poll this endpoint to observe the status transition from \"pending\" to \"approved\".",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "payments"
                ],
                "summary": "Get a payment by id",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Payment ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/payment.paymentResponse"
                        }
                    },
                    "400": {
                        "description": "id is not a valid UUID",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    },
                    "404": {
                        "description": "payment not found",
                        "schema": {
                            "$ref": "#/definitions/problem.Details"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "clinic.Address": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "São Paulo"
                },
                "state": {
                    "type": "string",
                    "example": "SP"
                },
                "street": {
                    "type": "string",
                    "example": "Av. Paulista, 1000"
                },
                "zip_code": {
                    "type": "string",
                    "example": "01310-100"
                }
            }
        },
        "clinic.Banking": {
            "type": "object",
            "properties": {
                "account": {
                    "type": "string"
                },
                "agency": {
                    "type": "string",
                    "example": "1234"
                },
                "bank": {
                    "type": "string",
                    "example": "Banco do Brasil"
                }
            }
        },
        "clinic.ClinicStatus": {
            "type": "string",
            "enum": [
                "pending",
                "active"
            ],
            "x-enum-varnames": [
                "StatusPending",
                "StatusActive"
            ]
        },
        "clinic.CreateInput": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/clinic.Address"
                },
                "banking": {
                    "$ref": "#/definitions/clinic.Banking"
                },
                "description": {
                    "type": "string",
                    "example": "Clínica odontológica completa"
                },
                "document": {
                    "description": "Document is the CPF/CNPJ. Immutable after creation.",
                    "type": "string",
                    "example": "12345678000199"
                },
                "email": {
                    "type": "string",
                    "example": "contato@clinicasorriso.com.br"
                },
                "legal_name": {
                    "type": "string",
                    "example": "Clínica Sorriso LTDA"
                },
                "opening_hours": {
                    "type": "string",
                    "example": "Seg a Sex, 8h às 18h"
                },
                "phone": {
                    "type": "string",
                    "example": "(11) 4000-1000"
                },
                "specialties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Ortodontia",
                        "Implantodontia"
                    ]
                },
                "trade_name": {
                    "type": "string",
                    "example": "Clínica Sorriso"
                },
                "website": {
                    "type": "string",
                    "example": "www.clinicasorriso.com.br"
                }
            }
        },
        "clinic.UpdateInput": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/clinic.Address"
                },
                "banking": {
                    "$ref": "#/definitions/clinic.Banking"
                },
                "description": {
                    "type": "string",
                    "example": "Clínica odontológica completa"
                },
                "document": {
                    "type": "string",
                    "example": "12345678000199"
                },
                "email": {
                    "type": "string",
                    "example": "contato@clinicasorriso.com.br"
                },
                "legal_name": {
                    "type": "string",
                    "example": "Clínica Sorriso LTDA"
                },
                "opening_hours": {
                    "type": "string",
                    "example": "Seg a Sex, 8h às 18h"
                },
                "phone": {
                    "type": "string",
                    "example": "(11) 4000-1000"
                },
                "specialties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "trade_name": {
                    "type": "string",
                    "example": "Clínica Sorriso"
                },
                "website": {
                    "type": "string",
                    "example": "www.clinicasorriso.com.br"
                }
            }
        },
        "clinic.addressDTO": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "São Paulo"
                },
                "state": {
                    "type": "string",
                    "example": "SP"
                },
                "street": {
                    "type": "string",
                    "example": "Av. Paulista, 1000"
                },
                "zip_code": {
                    "type": "string",
                    "example": "01310-100"
                }
            }
        },
        "clinic.bankingResponse": {
            "type": "object",
            "properties": {
                "account": {
                    "type": "string",
                    "example": "56789-0"
                },
                "agency": {
                    "type": "string",
                    "example": "1234"
                },
                "bank": {
                    "type": "string",
                    "example": "Banco do Brasil"
                }
            }
        },
        "clinic.clinicResponse": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/clinic.addressDTO"
                },
                "banking": {
                    "$ref": "#/definitions/clinic.bankingResponse"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
